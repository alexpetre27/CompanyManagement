# Copy to .env and fill in. Never commit the real .env.
# Generate secrets with:  openssl rand -base64 48

# --- PostgreSQL ---
POSTGRES_DB=management
POSTGRES_USER=management
POSTGRES_PASSWORD=change-me

# --- Backend ---
# Signs the API's access tokens (min. 32 characters).
JWT_SECRET=
# Shared between the Next.js server and the backend; required for Google sign-in.
INTERNAL_API_SECRET=
# Initial administrator, created only when the database has no users.
# If ADMIN_PASSWORD is empty a random one is generated and printed in the backend log.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@company.local
ADMIN_PASSWORD=
# Seed four demo projects on an empty database.
SEED_DEMO_DATA=true

# --- Frontend (Auth.js) ---
AUTH_SECRET=
# Public URL of the frontend.
AUTH_URL=http://localhost:3000
# Optional: enable "Sign in with Google".
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
